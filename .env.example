# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# CryptoBot API Token (get from @CryptoBot -> My Apps -> Create App)
CRYPTO_BOT_TOKEN=YOUR_CRYPTO_BOT_TOKEN_HERE

# KeyAuth Seller Key (Dashboard -> API Keys -> Seller Key)
KEYAUTH_SELLER_KEY=YOUR_SELLER_KEY_HERE

# KeyAuth App Name (exactly as in Dashboard)
KEYAUTH_APP_NAME=YOUR_APP_NAME_HERE

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=5235051874

# Support username
SUPPORT_USERNAME=@noethleft
